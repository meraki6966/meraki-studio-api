# ─── Server ──────────────────────────────────────────────────────────
PORT=19789

# ─── AI Video Generation ─────────────────────────────────────────────
# Primary: Replicate (Kling, Flux, Whisper)
REPLICATE_API_TOKEN=r8_your_token_here

# Fallback: fal.ai (Kling, Wan 2.1, Minimax)
FAL_KEY=your_fal_key_here

# ─── Narration (ElevenLabs) ────────────────────────────────────────────
# Powers generate_narration. Get the key from elevenlabs.io/app/settings/api-keys.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Adam's Professional Voice Clone ("Adam Meraki Voice"). Used when a tool
# call doesn't pass its own voiceId. Find/override voice IDs at
# elevenlabs.io/app/voice-lab.
ELEVENLABS_DEFAULT_VOICE_ID=vL2gpFAOVbi1L7GowOWz

# ─── Asset Storage ────────────────────────────────────────────────────
# Cloudinary (you already have this from Nail Check + VeloxSync)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Data Storage ─────────────────────────────────────────────────────
# Local path for project files and renders (Railway: use /app/data or a mounted volume)
DATA_DIR=./data

# ─── CORS ─────────────────────────────────────────────────────────────
# Your Vercel app URL (set this in Railway after deploying the frontend)
FRONTEND_URL=http://localhost:5173

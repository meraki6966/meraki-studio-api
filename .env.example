# ─── Server ──────────────────────────────────────────────────────────
PORT=19789

# ─── Access ───────────────────────────────────────────────────────────
# Required. Every route except /health refuses requests that do not send
# "Authorization: Bearer <this value>". If it is missing or shorter than 32
# characters the server stays locked. It does not fall back to being open.
# Make one with:  openssl rand -hex 32
# Keep a copy in your password manager. Never paste it into a chat.
STUDIO_API_TOKEN=

# ─── AI Video Generation ─────────────────────────────────────────────
# Primary: Replicate (Kling, Flux, Whisper)
REPLICATE_API_TOKEN=r8_your_token_here

# Fallback: fal.ai (Kling, Wan 2.1, Minimax)
FAL_KEY=your_fal_key_here

# Seedance 2.5 (runs on Replicate, opt-in via provider: "seedance"). All optional.
# SEEDANCE_MODEL=bytedance/seedance-2.5
# SEEDANCE_RESOLUTION=480p   # cost guard: keep low for drafts
# SEEDANCE_MAX_SECONDS=10    # clamps duration; hard ceiling is 30

# ─── Narration (ElevenLabs) ────────────────────────────────────────────
# Powers generate_narration. Get the key from elevenlabs.io/app/settings/api-keys.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Adam's Professional Voice Clone ("Adam Meraki Voice"). Used when a tool
# call doesn't pass its own voiceId. Find/override voice IDs at
# elevenlabs.io/app/voice-lab.
ELEVENLABS_DEFAULT_VOICE_ID=vL2gpFAOVbi1L7GowOWz

# ─── Asset Storage ────────────────────────────────────────────────────
# Cloudinary (you already have this from Nail Check + VeloxSync)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Data Storage ─────────────────────────────────────────────────────
# Local path for project files and renders (Railway: use /app/data or a mounted volume)
DATA_DIR=./data

# ─── CORS ─────────────────────────────────────────────────────────────
# Your Vercel app URL (set this in Railway after deploying the frontend)
FRONTEND_URL=http://localhost:5173
